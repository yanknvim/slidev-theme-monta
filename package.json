{
  "name": "slidev-theme-monta",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slidev/types": "^53.0.0",
    "unocss": "^66.12.0"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "typescript": "^6.0.3"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "description": "A Monta Method theme for Slidev: one idea per slide in the largest possible type, with v-click text blacked out until it is revealed.",
  "slidev": {
    "colorSchema": "both"
  }
}
